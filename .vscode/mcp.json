{
  "servers": {
    "solanaMcp": {
      "type": "http",
      "url": "https://mcp.solana.com/mcp"
    },
    "magicuidesign-mcp": {
      "command": "bunx",
      "args": [
        "-y",
        "@magicuidesign/mcp@latest"
      ]
    },
    "shadcn": {
      "command": "bunx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    }
  }
}
